<Project Sdk="Microsoft.NET.Sdk">
  <!-- Trayce Monitor v1: Win32 por P/Invoke, Direct2D/DirectWrite pela vtable, sem WinForms/WPF/WinUI.
       Publicacao: ReadyToRun + trimming (padrao). NativeAOT: -p:TrayceAot=true (pede o linker do MSVC). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>TrayceMonitor</RootNamespace>
    <AssemblyName>TrayceMonitor</AssemblyName>
    <Version>1.0.0</Version>
    <Product>Trayce Monitor</Product>
    <Description>Monitor de sistema leve para a bandeja do Windows 11</Description>
    <Copyright>MIT License</Copyright>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\brand\trayce.ico</ApplicationIcon>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <TieredPGO>false</TieredPGO>
    <DebuggerSupport>false</DebuggerSupport>
    <IsAotCompatible>true</IsAotCompatible>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TrayceAot)' == 'true'">
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TrayceAot)' != 'true'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
  </PropertyGroup>
</Project>
