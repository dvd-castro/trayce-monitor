<Project Sdk="Microsoft.NET.Sdk">
  <!-- Testes de unidade so do nucleo (sem Win32): os arquivos de src/TrayceMonitor/Core entram por link. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.5.2" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\TrayceMonitor\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <None Include="..\..\assets\brand\tokens.json" Link="tokens.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
